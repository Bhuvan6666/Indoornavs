# IndoorNav Backend Server Configuration

# Server Port (default 3001)
PORT=3001

# Supabase Database Configuration (Optional - falls back to local data/db.json if omitted)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-here

# Personal / Custom Backend Proxy (Optional)
# CUSTOM_BACKEND_URL=http://your-custom-backend.com/api
